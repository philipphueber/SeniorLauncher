<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 11+ only shows a launcher the apps it declares an interest in. A
         launcher must see every app, so this is the documented use case. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- The other Senior apps' settings, for "Save/Load all Senior apps' settings"
         (SettingsBackup). QUERY_ALL_PACKAGES already shows them; named here so
         the dependency is visible and survives if that permission ever goes. -->
    <queries>
        <provider android:authorities="app.phueber.seniorphone.backup" />
        <provider android:authorities="app.phueber.senioralert.backup" />
        <provider android:authorities="app.phueber.seniornav.backup" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:targetApi="35">

        <!-- The home screen. singleTask + stateNotNeeded is the platform pattern
             for launchers: one instance, never restored from a stale state.
             Also in the app list (LAUNCHER) so it can be opened before it is
             made the default home app. -->
        <activity
            android:name=".HomeActivity"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:theme="@style/HomeTheme"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Helper screens, reached only from the home screen while unlocked. -->
        <activity
            android:name=".AppsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />
        <activity
            android:name=".WidgetsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />
        <activity
            android:name=".ArrangeActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />
        <activity
            android:name=".NotificationAppsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />
        <!-- The current notifications for the home screen's notifications card,
             once the helper grants "Notification access". Only the system can
             bind it (the permission); it keeps everything in memory. -->
        <service
            android:name=".NotificationListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- Commands from automation apps (Trigly, Tasker): lock, unlock, colours.
             No permission on purpose, see AutomationReceiver. -->
        <receiver
            android:name=".AutomationReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="app.phueber.seniorlauncher.action.LOCK" />
                <action android:name="app.phueber.seniorlauncher.action.UNLOCK" />
                <action android:name="app.phueber.seniorlauncher.action.SET_THEME" />
                <action android:name="app.phueber.seniorlauncher.action.SET_ICONS" />
                <action android:name="app.phueber.seniorlauncher.action.MESSAGES_TAP" />
            </intent-filter>
        </receiver>
        <!-- The lock state for the other Senior apps; unlock with the PIN, and lock/unlock
             for SeniorNav's volume-button pattern only, see LockProvider. -->
        <provider
            android:name=".LockProvider"
            android:authorities="app.phueber.seniorlauncher.lock"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />
    </application>
</manifest>
