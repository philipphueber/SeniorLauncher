<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The notifications card ("Messages") on the home screen. -->
    <string name="notes_title">Messages</string>
    <string name="notes_none">No new messages</string>
    <!-- Unlocked only: access is granted but the system has not started the listener yet. Says nothing about whether there are messages. -->
    <string name="notes_connecting">Connecting to notifications …</string>
    <!-- Below the entries that fit, when some do not. -->
    <plurals name="notes_more">
        <item quantity="one">and %d more message</item>
        <item quantity="other">and %d more messages</item>
    </plurals>
    <!-- Several notifications of one chat, shown as one entry. -->
    <plurals name="notes_count">
        <item quantity="one">%d message</item>
        <item quantity="other">%d messages</item>
    </plurals>
    <string name="notes_just_now">just now</string>
    <plurals name="notes_minutes">
        <item quantity="one">%d min ago</item>
        <item quantity="other">%d min ago</item>
    </plurals>
    <!-- %1$s is the time, e.g. 14:20. -->
    <string name="notes_today">today %1$s</string>
    <string name="notes_yesterday">yesterday %1$s</string>
    <!-- %1$s is the day (Mon 3 Nov), %2$s the time. -->
    <string name="notes_earlier">%1$s, %2$s</string>
    <!-- Read aloud for an entry: app, sender, text, time. Text and time come with their own full stop (NoteList.sentence). -->
    <string name="notes_entry_cd">%1$s, %2$s: %3$s %4$s Tap to open.</string>
    <!-- Shown to the helper only (never while locked). -->
    <string name="notes_need_access">To show new messages here, this home screen needs “Notification access” once.</string>
    <string name="notes_allow">Allow notification access</string>
    <string name="notes_need_apps">Choose whose messages are shown here.</string>
    <string name="notes_choose_apps">Choose apps</string>

    <!-- Widgets screen. -->
    <string name="notes_builtin">Built into this home screen</string>
    <string name="notes_add_explain">New messages from the apps you choose, newest first. A tap opens the message.</string>
    <string name="notes_add_cd">Messages, built into this home screen: new messages from the apps you choose. Tap to add it to the home screen.</string>
    <string name="notes_access_on">Notification access: allowed ✓</string>
    <string name="notes_access_off">Notification access: not allowed yet, so nothing can be shown.</string>
    <string name="notes_apps_list">Shows messages from: %1$s</string>
    <string name="notes_apps_none">No apps chosen yet, so nothing is shown.</string>

    <!-- NotificationAppsActivity: whose notifications the card shows. -->
    <string name="notes_apps_title">Apps for messages</string>
    <string name="notes_apps_intro">New notifications of the apps marked “Shown ✓” appear on the home screen. They stay on this phone and are never saved.</string>
    <string name="notes_apps_show">Show</string>
    <string name="notes_apps_shown">Shown ✓</string>
    <string name="notes_apps_show_cd">Show messages from %1$s on the home screen</string>
    <string name="notes_apps_shown_cd">Messages from %1$s are shown on the home screen. Tap to hide them.</string>
</resources>
